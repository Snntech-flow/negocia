# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo nem no Git.

# Banco local (docker compose up -d). O .env.local de produção aponta para o Supabase: cuidado com db:push e seed.
DATABASE_URL=postgresql://negocialar:negocialar_dev_password@localhost:5433/negocialar_db

# Sessão: segredo forte com pelo menos 32 caracteres (openssl rand -hex 32). Obrigatório em produção.
NEGOCIAR_LAR_SESSION_SECRET=

# Conexões por instância na Vercel (padrão 3).
DATABASE_POOL_MAX=

# Envio de fotos de imóveis (Supabase Storage). Sem estas duas, a tela pede o link da foto.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEGOCIAR_LAR_PHOTO_BUCKET=imoveis

# Recuperação de senha por e-mail (Resend).
RESEND_API_KEY=
NEGOCIAR_LAR_EMAIL_FROM=NegociaLar <acesso@seu-dominio.com.br>
NEGOCIAR_LAR_APP_URL=https://seu-dominio.com.br

# Bartolomeu (assistente com IA).
GEMINI_API_KEY=
BARTOLOMEU_MODEL=

# Testes de integração: banco local descartável cujo nome contenha "test".
NEGOCIAR_LAR_TEST_DATABASE_URL=postgresql://negocialar_test:local_test_only@localhost:5432/negocialar_test

NEXT_PUBLIC_APP_URL=http://localhost:3000
